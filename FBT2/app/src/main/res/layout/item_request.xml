<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/request_item_bg"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Item Name + Approved By -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/itemName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PROJECTOR"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/itemApprovedBy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFD700"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:id="@+id/itemPurpose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Purpose: Presentation"
            android:textColor="#BDBDBD"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/itemBD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="B.D: 28/7/26"
            android:textColor="#4FC3F7"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/itemRD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R.D: 3/8/26"
            android:textColor="#F44336"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/itemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PENDING"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>

        <!-- NEW: Reject Reason Display -->
        <TextView
            android:id="@+id/itemRejectReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#F44336"
            android:textSize="13sp"
            android:textStyle="italic"
            android:layout_marginTop="6dp"
            android:padding="8dp"
            android:background="#2C2C2C"
            android:visibility="gone"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/deleteItemButton"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_delete"
        android:tint="#EF5350"
        android:padding="5dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_gravity="center_vertical"/>
</LinearLayout>